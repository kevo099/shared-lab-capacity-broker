{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shared-lab-capacity-broker:live-evidence:v1",
  "title": "Externally derived live safety evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_digest",
    "source_observed_at",
    "node_swap_in_bytes_per_second",
    "networks",
    "controllers",
    "backups",
    "active_owners",
    "exam_lease"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "source_observed_at": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telemetry", "controllers", "backups"],
      "properties": {
        "telemetry": {"$ref": "#/$defs/timestamp"},
        "controllers": {"$ref": "#/$defs/timestamp"},
        "backups": {"$ref": "#/$defs/timestamp"}
      }
    },
    "node_swap_in_bytes_per_second": {"$ref": "#/$defs/nullableIntegerMap"},
    "networks": {"$ref": "#/$defs/booleanMap"},
    "controllers": {"$ref": "#/$defs/booleanMap"},
    "backups": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/backup"}
    },
    "active_owners": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/semanticId"},
      "additionalProperties": {"$ref": "#/$defs/semanticId"}
    },
    "exam_lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/examLease"}
      ]
    }
  },
  "$defs": {
    "semanticId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableIntegerMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/semanticId"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          {"type": "null"}
        ]
      }
    },
    "booleanMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/semanticId"},
      "additionalProperties": {"type": "boolean"}
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "state", "age_seconds"],
      "properties": {
        "environment_id": {"$ref": "#/$defs/semanticId"},
        "state": {"enum": ["fresh", "stale", "unknown", "not_required"]},
        "age_seconds": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            {"type": "null"}
          ]
        }
      }
    },
    "examLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "state", "expires_at"],
      "properties": {
        "environment_id": {"$ref": "#/$defs/semanticId"},
        "state": {
          "enum": [
            "reserved",
            "activating",
            "active",
            "cleanup_due",
            "releasing",
            "cleanup_failed"
          ]
        },
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
